#!/bin/bash
# Pre-push hook - enforces basic safety checks

echo ""
echo "🔐 PRE-PUSH VALIDATION"
echo "======================================"

# Check 1: TEST_REPORT.md exists
if [ ! -f "reports/TEST_REPORT.md" ]; then
    echo "❌ FAIL: reports/TEST_REPORT.md not found"
    echo "Run tests first!"
    exit 1
fi

# Check 2: .env not staged
if git diff --cached --name-only | grep -q "^\.env$"; then
    echo "❌ FAIL: .env file is staged! Remove it before pushing"
    exit 1
fi

# Check 3: Large files (>10MB)
while IFS= read -r file; do
    if [ -f "$file" ]; then
        size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 10485760 ]; then
            echo "❌ FAIL: Large file $file ($(echo "scale=2; $size / 1048576" | bc) MB)"
            exit 1
        fi
    fi
done < <(git diff --cached --name-only)

# Check 4: Non-trivial changes must pass CR impact gate + tests via ci profile
CR_ID="${AISA_CR_ID:-$CR_ID}"
if [ -z "$CR_ID" ]; then
    echo "❌ FAIL: Missing CR id for gated validation"
    echo "Set AISA_CR_ID or CR_ID before push (example: export AISA_CR_ID=CR-20260713-001)"
    exit 1
fi

echo ""
echo "Running gated validation: python scripts/build.py --profile ci --cr-id $CR_ID"
python scripts/build.py --profile ci --cr-id "$CR_ID"
if [ $? -ne 0 ]; then
    echo "❌ FAIL: Gated validation failed for CR $CR_ID"
    exit 1
fi

echo ""
echo "✅ Pre-push checks passed!"
exit 0

